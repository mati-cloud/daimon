+    const OSC52 = /\x1b\]52;[^;\x07\x1b]*;([A-Za-z0-9+/=]*)(\x07|\x1b\\)?/g;
+    let osc52Carry = '';
+    function clipboardWrites(bytes) {
+        const text = osc52Carry + latin1.decode(bytes);
+        osc52Carry = '';
+        if (!text.includes('\x1b]52;'))
